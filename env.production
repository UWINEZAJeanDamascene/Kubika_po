# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# This file is for production server only.
# NOT committed to git - see .gitignore
# =============================================================================

# Server
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://yourdomain.com

# Database - Production PostgreSQL/Neon (required system of record)
DATABASE_URL=postgresql://user:password@production-pooler.example.com/stock_management?sslmode=require
DIRECT_URL=postgresql://user:password@production.example.com/stock_management?sslmode=require
PRISMA_CONNECTION_LIMIT=20
PRISMA_POOL_TIMEOUT=10
PRISMA_APPLICATION_NAME=stock-management-api
QUERY_MAX_ROWS=500
QUERY_ENFORCE_MAX_ROWS=true
RECONCILIATION_BATCH_SIZE=500

# MongoDB - legacy-only domains during migration

# JWT - Generate strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_VERY_STRONG_RANDOM_KEY_AT_LEAST_64_CHARACTERS
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Session
SESSION_TTL=86400
SESSION_MAX_CONCURRENT=3

# Security - Stricter settings
BCRYPT_ROUNDS=12
LOW_STOCK_THRESHOLD=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis - Production Upstash or cloud Redis
UPSTASH_REDIS_REST_URL=https://production-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=production-redis-token

# Email - Production email
EMAIL_PROVIDER=gmail
GMAIL_USER=admin@yourdomain.com
GMAIL_APP_PASSWORD=production-app-password
EMAIL_FROM_ADDRESS=admin@yourdomain.com
EMAIL_FROM_NAME=KUBIKA SYSTEM

# Notifications - Full enabled
PAYMENT_REMINDER_DAYS=3
DAILY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_ENABLED=true
LARGE_ORDER_THRESHOLD=10000

# Logging - Warn level for performance
LOG_LEVEL=warn
LOG_QUERIES=false

# Feature flags - All enabled
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_ADVANCED_REPORTING=true
ENABLE_CLOUD_BACKUP=true

# Sentry - Production project (required — Phase 0)
SENTRY_DSN=https://xxxxx@sentry.io/production-project
SENTRY_TRACES_SAMPLE_RATE=0.1
APDEX_T_MS=1000
SENTRY_APDEX_PROJECT_T_MS=1000
SENTRY_APDEX_PROJECT_CONFIGURED=true
PERFORMANCE_REQUIRE_REDIS=true
PERFORMANCE_REQUIRE_SENTRY=true
PERFORMANCE_REQUIRE_SENTRY_APDEX=true

# =============================================================================
# EBM / RRA VSDC CONFIGURATION
# =============================================================================

EBM_MODE=production
VSDC_BASE_URL=http://localhost:8080/vsdc
RRA_SANDBOX_URL=https://sdcsandbox.rra.gov.rw
RRA_PRODUCTION_URL=https://api-ebm.rra.gov.rw
EBM_RETRY_INTERVAL_MINUTES=5
EBM_RETRY_BASE_DELAY_SECONDS=60
EBM_RETRY_BATCH_SIZE=10
EBM_MAX_RETRIES=5
EBM_CODE_SYNC_INTERVAL_HOURS=24
EBM_IMPORT_SYNC_INTERVAL_HOURS=12
EBM_PURCHASE_SYNC_INTERVAL_HOURS=6
EBM_HTTP_TIMEOUT_MS=30000
