# =============================================================================
# DEVELOPMENT ENVIRONMENT
# =============================================================================
# This file is for local development only.
# NOT committed to git - see .gitignore
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database - PostgreSQL system of record
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_management?schema=public
DIRECT_URL=postgresql://stock:stock@localhost:5432/stock_management?schema=public
PRISMA_CONNECTION_LIMIT=20
PRISMA_POOL_TIMEOUT=10
PRISMA_APPLICATION_NAME=stock-management-api
QUERY_MAX_ROWS=500
QUERY_ENFORCE_MAX_ROWS=true
RECONCILIATION_BATCH_SIZE=500

# MongoDB - legacy-only domains during migration; not used by Phase 0 metrics

# JWT - Longer expiry for easier testing
JWT_SECRET=dev-secret-key-not-for-production-use-only
JWT_EXPIRE=60m
JWT_REFRESH_EXPIRE=7d

# Session
SESSION_TTL=86400
SESSION_MAX_CONCURRENT=5

# Security
BCRYPT_ROUNDS=10
LOW_STOCK_THRESHOLD=10

# Redis - Required for Phase 0 metrics/cache in development as well.
# Use the explicit opt-out only when intentionally running process-local fallback.
REDIS_HOST=localhost
REDIS_PORT=6379
# PERFORMANCE_REQUIRE_REDIS=false

# Email - Use console for development (no actual emails)
EMAIL_PROVIDER=console

# Notifications - Disable in development
DAILY_SUMMARY_ENABLED=false
WEEKLY_SUMMARY_ENABLED=false
LARGE_ORDER_THRESHOLD=10000

# Logging
LOG_LEVEL=debug
LOG_QUERIES=true

# Feature flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_ADVANCED_REPORTING=true

# =============================================================================
# PERFORMANCE BASELINE - Phase 0 Testing
