# =============================================================================
# DEVELOPMENT ENVIRONMENT
# =============================================================================
# This file is for local development only.
# NOT committed to git - see .gitignore
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database - Local MongoDB
MONGODB_URI=mongodb://localhost:27017/stock-management
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# JWT - Longer expiry for easier testing
JWT_SECRET=dev-secret-key-not-for-production-use-only
JWT_EXPIRE=60m
JWT_REFRESH_EXPIRE=7d

# Session
SESSION_TTL=86400
SESSION_MAX_CONCURRENT=5

# Security
BCRYPT_ROUNDS=10
LOW_STOCK_THRESHOLD=10

# Redis - Local development (optional, can use no-op if not available)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Email - Use console for development (no actual emails)
EMAIL_PROVIDER=console

# Notifications - Disable in development
DAILY_SUMMARY_ENABLED=false
WEEKLY_SUMMARY_ENABLED=false
LARGE_ORDER_THRESHOLD=10000

# Logging
LOG_LEVEL=debug
LOG_QUERIES=true

# Feature flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_ADVANCED_REPORTING=true