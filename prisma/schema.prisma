  @@index([companyId, assetId, changedAt(sort: Desc)])
  @@index([companyId, fromStatus, toStatus])
  @@index([assetId, toStatus])
  @@index([changedAt(sort: Desc)])
  @@map("asset_status_histories")
}

// ── Phase 10 — HR / Payroll ────────────────────────────────────────────────

model Employee {
  id                      String    @id @db.Char(24)
  companyId               String    @map("company_id") @db.Char(24)
  employeeId              String    @map("employee_id")
  status                  String    @default("active")
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  email                   String?
  phone                   String?
  dateOfBirth             DateTime? @map("date_of_birth") @db.Timestamptz(3)
  gender                  String?
  nationalId              String?   @map("national_id")
  hireDate                DateTime? @map("hire_date") @db.Timestamptz(3)
  terminationDate         DateTime? @map("termination_date") @db.Timestamptz(3)
  employmentType          String    @default("full-time") @map("employment_type")
  department              String?
  departmentRefId         String?   @map("department_ref_id") @db.Char(24)
  position                String?
  location                String?
  managerId               String?   @map("manager_id") @db.Char(24)
  laborType               String?   @map("labor_type")
  defaultDirectPercentage Float?    @map("default_direct_percentage")
  costCenter              String?   @map("cost_center")
  bankName                String?   @map("bank_name")
  bankAccount             String?   @map("bank_account")
  bankBranch              String?   @map("bank_branch")
  mobileMoneyNumber       String?   @map("mobile_money_number")
  taxStatus               String    @default("resident") @map("tax_status")
  rssbRegistrationNumber  String?   @map("rssb_registration_number")
  tinNumber               String?   @map("tin_number")
