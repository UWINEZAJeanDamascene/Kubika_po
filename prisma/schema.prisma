  loanType                 String    @map("loan_type")
  type                     String?
  purpose                  String?
  originalAmount           Decimal   @map("original_amount") @db.Decimal(19, 2)
  outstandingBalance       Decimal   @map("outstanding_balance") @db.Decimal(19, 2)
  amountPaid               Decimal   @default(0) @map("amount_paid") @db.Decimal(19, 2)
  interestRate             Decimal   @default(0) @map("interest_rate") @db.Decimal(19, 4)
