  entityId             String?   @map("entity_id") @db.Char(24)
  baseCurrency         String?   @map("base_currency")
  exchangeRateType     String    @default("spot") @map("exchange_rate_type")
  exchangeRate         Decimal   @default(1) @map("exchange_rate") @db.Decimal(19, 6)
  allowMultiCurrency   Boolean   @default(false) @map("allow_multi_currency")
  allocationMethod     String    @default("manual") @map("allocation_method")
  status               String    @default("draft")
  workflowId           String?   @map("workflow_id") @db.Char(24)
  currentApprovalStep  Int       @default(0) @map("current_approval_step")
  totalApprovalSteps   Int       @default(0) @map("total_approval_steps")
  createdById          String    @map("created_by") @db.Char(24)
  approvedById         String?   @map("approved_by") @db.Char(24)
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz(3)
  lockedById           String?   @map("locked_by") @db.Char(24)
  lockedAt             DateTime? @map("locked_at") @db.Timestamptz(3)
  unlockedById         String?   @map("unlocked_by") @db.Char(24)
  unlockedAt           DateTime? @map("unlocked_at") @db.Timestamptz(3)
  rejectedById         String?   @map("rejected_by") @db.Char(24)
  rejectedAt           DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionReason      String    @default("") @map("rejection_reason")
  closedById           String?   @map("closed_by") @db.Char(24)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(3)
  closeNotes           String    @default("") @map("close_notes")
  notes                String    @default("")
  autoLock             Json      @default("{}") @map("auto_lock")
  fiscalYearEnd        DateTime? @map("fiscal_year_end") @db.Timestamptz(3)
  yearEndLock          Boolean   @default(false) @map("year_end_lock")
  autoLocked           Boolean   @default(false) @map("auto_locked")
  scenarioType         String    @default("base") @map("scenario_type")
  scenarioName         String?   @map("scenario_name")
  scenarioGroupId      String?   @map("scenario_group_id")
  isPrimaryScenario    Boolean   @default(true) @map("is_primary_scenario")
  parentBudgetId       String?   @map("parent_budget_id") @db.Char(24)
  scenarioDescription  String    @default("") @map("scenario_description")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity             Company?                @relation("BudgetEntity", fields: [entityId], references: [id])
  workflow           BudgetWorkflowConfig?   @relation(fields: [workflowId], references: [id])
  parentBudget       Budget?                 @relation("BudgetScenarioTree", fields: [parentBudgetId], references: [id])
  childBudgets       Budget[]                @relation("BudgetScenarioTree")
  lines              BudgetLine[]
  actualConsumptions BudgetActualConsumption[]
  transfers          BudgetTransfer[]
  revisions          BudgetRevision[]
  periodLock         BudgetPeriodLock?
  approvals          BudgetApproval[]
  alerts             BudgetAlert[]
  encumbrances       Encumbrance[]

  @@unique([companyId, fiscalYear, name, scenarioType])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, departmentId])
  @@index([companyId, ownerId])
  @@index([companyId, entityId])
  @@index([companyId, category])
  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, scenarioGroupId])
  @@index([companyId, parentBudgetId])
  @@map("budgets")
}

