  budgetSpent      Decimal   @default(0) @map("budget_spent") @db.Decimal(19, 2)
  budgetRemaining  Decimal   @default(0) @map("budget_remaining") @db.Decimal(19, 2)
  startDate        DateTime? @map("start_date") @db.Timestamptz(3)
  endDate          DateTime? @map("end_date") @db.Timestamptz(3)
  actualStartDate  DateTime? @map("actual_start_date") @db.Timestamptz(3)
  actualEndDate    DateTime? @map("actual_end_date") @db.Timestamptz(3)
  departmentId     String?   @map("department_id") @db.Char(24)
  clientId         String?   @map("client_id") @db.Char(24)
  managerId        String?   @map("manager_id") @db.Char(24)
  billingType      String    @default("none") @map("billing_type")
  contractValue    Decimal   @default(0) @map("contract_value") @db.Decimal(19, 2)
  progressPercent  Decimal   @default(0) @map("progress_percent") @db.Decimal(19, 4)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent             Project?                  @relation("ProjectTree", fields: [parentId], references: [id])
  children           Project[]                 @relation("ProjectTree")
  budgetLines        BudgetLine[]
  actualConsumptions BudgetActualConsumption[]

  @@unique([companyId, projectCode])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, parentId])
  @@index([companyId, wbsCode])
  @@index([companyId, departmentId])
  @@index([companyId, clientId])
  @@index([companyId, isActive])
  @@map("projects")
}

// ── Phase 10 — EBM / RRA VSDC ──────────────────────────────────────────────

model EbmDevice {
  id               String    @id @db.Char(24)
  companyId        String    @map("company_id") @db.Char(24)
  tin              String
  branchId         String    @map("branch_id") @db.VarChar(2)
  branchName       String?   @map("branch_name")
  branchRefId      String?   @map("branch_ref_id") @db.Char(24)
  deviceSerialNo   String    @map("device_serial_no")
  status           String    @default("not_initialized")
  initializedAt    DateTime? @map("initialized_at") @db.Timestamptz(3)
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastErrorMessage String?   @map("last_error_message")
  initializedMode  String?   @map("initialized_mode")
  lastAttemptMode  String?   @map("last_attempt_mode")
  initResult       Json?     @map("init_result")
  createdById      String?   @map("created_by") @db.Char(24)
  updatedById      String?   @map("updated_by") @db.Char(24)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, deviceSerialNo])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@map("ebm_devices")
}

model EbmCode {
  id            String   @id @db.Char(24)
  companyId     String   @map("company_id") @db.Char(24)
  codeClass     String   @map("code_class")
  codeClassName String?  @map("code_class_name")
  code          String
  name          String?
  description   String?
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  source        Json     @default("{}")
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codeClass, code])
  @@index([companyId, codeClass, active])
  @@map("ebm_codes")
}

model EbmItemClass {
  id             String   @id @db.Char(24)
  companyId      String   @map("company_id") @db.Char(24)
  itemClassCode  String   @map("item_class_code")
  itemClassName  String   @map("item_class_name")
  itemClassLevel Int?     @map("item_class_level")
  parentCode     String?  @map("parent_code")
  taxTypeCode    String?  @map("tax_type_code")
  majorTarget    Boolean  @default(false) @map("major_target")
  active         Boolean  @default(true)
  source         Json     @default("{}")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, itemClassCode])
  @@index([companyId, itemClassName])
  @@index([companyId, parentCode])
  @@map("ebm_item_classes")
}

// Global RRA taxpayer registry — no companyId
model EbmTin {
  id           String   @id @db.Char(24)
  tin          String   @unique
  taxpayerName String   @map("taxpayer_name")
  statusCode   String?  @map("status_code")
  provinceName String?  @map("province_name")
  districtName String?  @map("district_name")
  active       Boolean  @default(true)
  source       Json     @default("{}")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tin, taxpayerName])
  @@index([active])
  @@map("ebm_tins")
}

model EbmNotice {
  id           String   @id @db.Char(24)
  companyId    String   @map("company_id") @db.Char(24)
  noticeNumber String   @map("notice_number")
  title        String?
  content      String?
  noticeDate   String?  @map("notice_date")
  active       Boolean  @default(true)
  source       Json     @default("{}")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, noticeNumber])
  @@index([companyId, noticeDate(sort: Desc)])
  @@map("ebm_notices")
}

model EbmImportedItem {
  id                  String    @id @db.Char(24)
  companyId           String    @map("company_id") @db.Char(24)
  branchId            String    @default("00") @map("branch_id") @db.VarChar(2)
  importTaskCode      String    @map("import_task_code")
  importDeclarationNo String?   @map("import_declaration_no")
  importDate          DateTime? @map("import_date") @db.Timestamptz(3)
  itemCode            String?   @map("item_code")
  itemName            String    @map("item_name")
  itemClassCode       String?   @map("item_class_code")
  quantity            Decimal   @db.Decimal(19, 4)
  unitCode            String?   @map("unit_code")
  originCountryCode   String?   @map("origin_country_code")
  supplierTin         String?   @map("supplier_tin")
  supplierName        String?   @map("supplier_name")
  unitCost            Decimal   @default(0) @map("unit_cost") @db.Decimal(19, 2)
  taxTypeCode         String?   @map("tax_type_code")
  taxRate             Decimal   @default(0) @map("tax_rate") @db.Decimal(19, 4)
  raw                 Json      @default("{}")
  confirmationStatus  String    @default("pending") @map("confirmation_status")
  pulledAt            DateTime  @default(now()) @map("pulled_at") @db.Timestamptz(3)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById       String?   @map("confirmed_by") @db.Char(24)
  rejectedAt          DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectedById        String?   @map("rejected_by") @db.Char(24)
  rejectionReason     String?   @map("rejection_reason")
  stockUpdated        Boolean   @default(false) @map("stock_updated")
  stockUpdateError    String?   @map("stock_update_error")
  confirmationError   String?   @map("confirmation_error")
  productId           String?   @map("product_id") @db.Char(24)
  warehouseId         String?   @map("warehouse_id") @db.Char(24)
  supplierId          String?   @map("supplier_id") @db.Char(24)
  purchaseOrderId     String?   @map("purchase_order_id") @db.Char(24)
  grnId               String?   @map("grn_id") @db.Char(24)
  rraConfirmedAt      DateTime? @map("rra_confirmed_at") @db.Timestamptz(3)
  rraResult           Json?     @map("rra_result")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, importTaskCode])
  @@index([companyId, confirmationStatus, importDate(sort: Desc)])
  @@index([companyId, itemCode])
  @@map("ebm_imported_items")
}

model EbmUnmatchedPurchase {
  id                 String    @id @db.Char(24)
  companyId          String    @map("company_id") @db.Char(24)
  branchId           String    @map("branch_id") @db.VarChar(2)
  supplierTin        String?   @map("supplier_tin")
  supplierName       String?   @map("supplier_name")
  sellerInvoiceNo    String    @map("seller_invoice_no")
  invoiceDate        DateTime? @map("invoice_date") @db.Timestamptz(3)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(19, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(19, 2)
  raw                Json      @default("{}")
  status             String    @default("unmatched")
  linkedDocumentType String?   @map("linked_document_type")
  linkedDocumentId   String?   @map("linked_document_id") @db.Char(24)
  reviewedById       String?   @map("reviewed_by") @db.Char(24)
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(3)
  pulledAt           DateTime  @default(now()) @map("pulled_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, supplierTin, sellerInvoiceNo])
  @@index([companyId, branchId])
  @@index([companyId, status, pulledAt(sort: Desc)])
  @@map("ebm_unmatched_purchases")
}

model EbmSubmissionQueue {
  id           String    @id @db.Char(24)
  companyId    String    @map("company_id") @db.Char(24)
  documentType String    @map("document_type")
  documentId   String    @map("document_id") @db.Char(24)
  endpoint     String
  operationKey String    @default("default") @map("operation_key")
  payload      Json
  ebmStatus    String    @default("pending") @map("ebm_status")
  retryCount   Int       @default(0) @map("retry_count")
  maxRetries   Int       @default(5) @map("max_retries")
  nextRetryAt  DateTime  @default(now()) @map("next_retry_at") @db.Timestamptz(3)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastError    Json      @default("{}") @map("last_error")
  attempts     Json      @default("[]")
  isRetryable  Boolean   @default(true) @map("is_retryable")
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  alerts  EbmAlert[]

  @@unique([companyId, documentType, documentId, endpoint, operationKey])
  @@index([companyId, documentType])
  @@index([companyId, documentId])
  @@index([ebmStatus, isRetryable, nextRetryAt])
  @@map("ebm_submission_queues")
}

model EbmAlert {
  id               String    @id @db.Char(24)
  companyId        String    @map("company_id") @db.Char(24)
  queueId          String    @map("queue_id") @db.Char(24)
  documentType     String    @map("document_type")
  documentId       String    @map("document_id") @db.Char(24)
  endpoint         String
  operationKey     String    @default("default") @map("operation_key")
  attemptsMade     Int       @map("attempts_made")
  lastErrorMessage String?   @map("last_error_message")
  lastErrorCode    String?   @map("last_error_code")
  lastHttpStatus   Int?      @map("last_http_status")
  payload          Json?
  abandonedAt      DateTime  @default(now()) @map("abandoned_at") @db.Timestamptz(3)
  acknowledged     Boolean   @default(false)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?   @map("acknowledged_by") @db.Char(24)
  resetAt          DateTime? @map("reset_at") @db.Timestamptz(3)
  resetById        String?   @map("reset_by") @db.Char(24)
  status           String    @default("open")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  queue   EbmSubmissionQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([companyId, acknowledged, abandonedAt(sort: Desc)])
  @@index([queueId, status])
  @@index([companyId, documentType])
  @@map("ebm_alerts")
}

model EbmSyncState {
  id                   String    @id @db.Char(24)
  companyId            String    @map("company_id") @db.Char(24)
  branchId             String    @map("branch_id") @db.VarChar(2)
  syncType             String    @map("sync_type")
  lastReqDt            String    @default("20000101000000") @map("last_req_dt")
  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at") @db.Timestamptz(3)
  lastAttemptAt        DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastErrorMessage     String?   @map("last_error_message")
  mode                 String    @default("mock")
  summary              Json      @default("{}")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, syncType, mode])
  @@index([companyId, syncType])
  @@index([companyId, lastSuccessfulSyncAt])
  @@map("ebm_sync_states")
}
