// Phase 1 — Tenancy & Auth
// Legacy Mongo ObjectId strings preserved as CHAR(24) PKs for API/_id compatibility.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations — required with Neon's
  // PgBouncer pooler endpoint. Point at the same URL when not using a pooler.
  directUrl = env("DIRECT_URL")
}

enum CompanyApprovalStatus {
  pending
  approved
  rejected
}

enum SubscriptionPlan {
  starter
  professional
  enterprise
}

enum SubscriptionStatus {
  active
  past_due
  suspended
  cancelled
}

enum BillingCycle {
  monthly
  quarterly
  annual
}

/// Platform-wide subscription package catalog (pricing tiers shown on signup/pricing pages).
model SubscriptionPlanCatalog {
  id                   String       @id @db.Char(24)
  key                  String       @unique
  name                 String
  description          String       @default("")
  features             String[]     @default([])
  modules              String[]     @default([])
  outcomes             String[]     @default([])
  badge                String       @default("")
  icon                 String       @default("")
  featured             Boolean      @default(false)
  buttonLabel          String       @default("") @map("button_label")
  defaultBillingAmount Decimal      @default(0) @map("default_billing_amount") @db.Decimal(19, 4)
  defaultBillingCycle  BillingCycle @default(monthly) @map("default_billing_cycle")
  isActive             Boolean      @default(true) @map("is_active")
  sortOrder            Int          @default(0) @map("sort_order")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive])
  @@index([sortOrder])
  @@map("subscription_plan_catalog")
}

enum CompanyUserStatus {
  active
  inactive
  pending
  suspended
}

model Company {
  id                         String                 @id @db.Char(24)
  name                       String
  code                       String                 @unique
  legalName                  String?                @map("legal_name")
  registrationNumber         String?                @map("registration_number")
  taxIdentificationNumber    String?                @map("tax_identification_number")
  email                      String?
  phone                      String?
  website                    String?
  address                    Json                   @default("{}")
  logoUrl                    String?                @map("logo_url")
  baseCurrency               String                 @default("RWF") @map("base_currency")
  fiscalYearStartMonth       Int                    @default(1) @map("fiscal_year_start_month")
  defaultPaymentTermsDays    Int                    @default(30) @map("default_payment_terms_days")
  industry                   String?
  isActive                   Boolean                @default(true) @map("is_active")
  approvalStatus             CompanyApprovalStatus  @default(approved) @map("approval_status")
  registrationRejectionReason String?               @map("registration_rejection_reason")
  isVatRegistered            Boolean                @default(false) @map("is_vat_registered")
  vatRatePct                 Float                  @default(18) @map("vat_rate_pct")
  setupCompleted             Boolean                @default(false) @map("setup_completed")
  setupStepsCompleted        Json                   @default("{}") @map("setup_steps_completed")
  subscriptionPlan           SubscriptionPlan       @default(starter) @map("subscription_plan")
  subscriptionStatus         SubscriptionStatus     @default(active) @map("subscription_status")
  billingCycle               BillingCycle           @default(monthly) @map("billing_cycle")
  billingAmount              Decimal                @default(0) @map("billing_amount") @db.Decimal(19, 4)
  nextBillingDate            DateTime?              @map("next_billing_date") @db.Timestamptz(3)
  featureAccess              Json                   @default("{}") @map("feature_access")
  subscriptionModules        String[]               @default([]) @map("subscription_modules")
  platformNotes              String                 @default("") @map("platform_notes")
  lastPaymentReminderAt      DateTime?              @map("last_payment_reminder_at") @db.Timestamptz(3)
  lastPlatformMessageAt      DateTime?              @map("last_platform_message_at") @db.Timestamptz(3)
  trialEndsAt                DateTime?              @map("trial_ends_at") @db.Timestamptz(3)
  createdById                String?                @map("created_by") @db.Char(24)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          User[]
  roles          Role[]
  companyUsers   CompanyUser[]
  sequences      SequenceCounter[]
  ebmSequences   EbmSequenceCounter[]
  categories     Category[]
  products       Product[]
  warehouses     Warehouse[]
  clients        Client[]
  suppliers      Supplier[]
  chartOfAccounts ChartOfAccount[]
  taxes          Tax[]
  taxRates       TaxRate[]
  exchangeRates  ExchangeRate[]
  departments    Department[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  inventoryBatches InventoryBatch[]
  inventoryLayers InventoryLayer[]
  stockTransfers StockTransfer[]
  stockTransferLines StockTransferLine[]
  stockAudits    StockAudit[]
  reorderPoints  ReorderPoint[]
  stockBatches   StockBatch[]
  stockSerialNumbers StockSerialNumber[]
  journalEntries JournalEntry[]
  journalEntryLines JournalEntryLine[]
  accountBalances AccountBalance[]
  accountMappings AccountMapping[]
  accountingPeriods AccountingPeriod[]
  periods        Period[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
  deliveryNotes  DeliveryNote[]
  pickPacks      PickPack[]
  pickPackLines  PickPackLine[]
  arReceipts     ARReceipt[]
  arReceiptAllocations ARReceiptAllocation[]
  recurringInvoices RecurringInvoice[]
  recurringInvoiceRuns RecurringInvoiceRun[]
  purchaseOrders PurchaseOrder[]
  purchases      Purchase[]
  goodsReceivedNotes GoodsReceivedNote[]
  purchaseReturns PurchaseReturn[]
  apPayments     APPayment[]
  apPaymentAllocations APPaymentAllocation[]
  freightBills   FreightBill[]
  bankAccounts               BankAccount[]
  bankTransactions           BankTransaction[]
  bankStatementLines         BankStatementLine[]
  bankReconciliations        BankReconciliation[]
  bankReconciliationSessions BankReconciliationSession[]
  bankStatementTransactions  BankStatementTransaction[]
  bankReconciliationMatches  BankReconciliationMatch[]
  pettyCashFloats            PettyCashFloat[]
  pettyCashExpenses          PettyCashExpense[]
  pettyCashReplenishments    PettyCashReplenishment[]
  pettyCashTransactions      PettyCashTransaction[]
  pettyCashReconciliations   PettyCashReconciliation[]
  reportSnapshots            ReportSnapshot[]
  assetCategories            AssetCategory[]
  fixedAssets                FixedAsset[]
  depreciationEntries        DepreciationEntry[]
  assetDisposalEvents        AssetDisposalEvent[]
  assetStatusHistories       AssetStatusHistory[]
  employees                  Employee[]
  salaryHistories            SalaryHistory[]
  payrolls                   Payroll[]
  payrollRuns                PayrollRun[]
  timesheets                 Timesheet[]
  employeeAdvances           EmployeeAdvance[]
  loans                      Loan[]
  expenses                   Expense[]
  budgets                    Budget[]
  budgetLines                BudgetLine[]
  budgetWorkflowConfigs      BudgetWorkflowConfig[]
  budgetActualConsumptions   BudgetActualConsumption[]
  budgetTransfers            BudgetTransfer[]
  budgetRevisions            BudgetRevision[]
  budgetPeriodLocks          BudgetPeriodLock[]
  budgetApprovals            BudgetApproval[]
  budgetAlerts               BudgetAlert[]
  encumbrances               Encumbrance[]
  projects                   Project[]
  ebmDevices                 EbmDevice[]
  ebmCodes                   EbmCode[]
  ebmItemClasses             EbmItemClass[]
  ebmNotices                 EbmNotice[]
  ebmImportedItems           EbmImportedItem[]
  ebmUnmatchedPurchases      EbmUnmatchedPurchase[]
  ebmSubmissionQueues        EbmSubmissionQueue[]
  ebmAlerts                  EbmAlert[]
  ebmSyncStates              EbmSyncState[]
  ipWhitelists               IpWhitelist[]
  actionLogs                 ActionLog[]
  auditLogs                  AuditLog[]
  tillSessions               TillSession[]
  invoiceReceiptMetadata     InvoiceReceiptMetadata[]
  deferredRevenues           DeferredRevenue[]
  prepaidExpenses            PrepaidExpense[]
  budgetEntities             Budget[] @relation("BudgetEntity")
  createdBy      User?          @relation("CompanyCreatedBy", fields: [createdById], references: [id])

  @@index([isActive])
  @@map("companies")
}

// Step 8 — atomic reference-number counters (replaces Mongo Sequence model)
model SequenceCounter {
  companyId String   @map("company_id") @db.Char(24)
  name      String   @db.VarChar(50)
  year      Int      @default(0)
  value     BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, name, year])
  @@map("sequences")
}

enum EbmSequenceType {
  sales_invoice
  receipt
  report
  stock_sar
}

// Step 8 — EBM fiscal receipt/invoice counters (replaces Mongo EBMSequence)
model EbmSequenceCounter {
  companyId    String          @map("company_id") @db.Char(24)
  branchId     String          @map("branch_id") @db.VarChar(2)
  sequenceType EbmSequenceType @map("sequence_type")
  lastNumber   BigInt          @default(0) @map("last_number")
  seededFrom   String?         @map("seeded_from")
  seededAt     DateTime?       @map("seeded_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, branchId, sequenceType])
  @@map("ebm_sequences")
}

model User {
  id                    String    @id @db.Char(24)
  name                  String
  email                 String
  password              String
  refreshToken          String?   @map("refresh_token")
  refreshTokenHash      String?   @map("refresh_token_hash")
  companyId             String?   @map("company_id") @db.Char(24)
  role                  String    @default("viewer")
  departmentId          String?   @map("department_id") @db.Char(24)
  branchId              String?   @map("branch_id") @db.Char(24)
  isActive              Boolean   @default(true) @map("is_active")
  lastLogin             DateTime? @map("last_login") @db.Timestamptz(3)
  createdById           String?   @map("created_by") @db.Char(24)
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  passwordChangedAt     DateTime? @map("password_changed_at") @db.Timestamptz(3)
  tempPassword          Boolean   @default(false) @map("temp_password")
  avatar                String?
  phone                 String?
  jobTitle              String?   @map("job_title")
  bio                   String?
  twoFAEnabled          Boolean   @default(false) @map("two_fa_enabled")
  twoFASecret           String?   @map("two_fa_secret")
  twoFAConfirmed        Boolean   @default(false) @map("two_fa_confirmed")
  ipWhitelist           String[]  @default([]) @map("ip_whitelist")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company           Company?      @relation(fields: [companyId], references: [id])
  createdBy         User?         @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers      User[]        @relation("UserCreatedBy")
  createdCompanies  Company[]     @relation("CompanyCreatedBy")
  roles             UserRole[]
  companyUsers      CompanyUser[]
  refreshTokens     RefreshToken[]
  sessions          UserSession[]
  actionLogs        ActionLog[]
  auditLogs         AuditLog[]
  tillSessions      TillSession[]

  @@unique([companyId, email])
  @@index([email])
  @@index([passwordResetToken])
  @@map("users")
}

model Role {
  id           String   @id @db.Char(24)
  companyId    String?  @map("company_id") @db.Char(24)
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  permissions  Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company?   @relation(fields: [companyId], references: [id])
  users   UserRole[]

  @@index([companyId, name])
  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Char(24)
  roleId String @map("role_id") @db.Char(24)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model CompanyUser {
  id               String            @id @db.Char(24)
  userId           String            @map("user_id") @db.Char(24)
  companyId        String            @map("company_id") @db.Char(24)
  role             String            @default("viewer")
  permissions      Json              @default("[]")
  status           CompanyUserStatus @default(active)
  approvedAt       DateTime?         @map("approved_at") @db.Timestamptz(3)
  approvedById     String?           @map("approved_by") @db.Char(24)
  departmentId     String?           @map("department_id") @db.Char(24)
  preferences      Json              @default("{}")
  lastActiveAt     DateTime?         @map("last_active_at") @db.Timestamptz(3)
  isPrimaryContact Boolean           @default(false) @map("is_primary_contact")
  jobTitle         String?           @map("job_title")
  phone            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId, status])
  @@index([companyId, status])
  @@map("company_users")
}

model RefreshToken {
  id        String   @id @db.Char(24)
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Char(24)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id           String   @id @db.Char(24)
  userId       String   @map("user_id") @db.Char(24)
  isActive     Boolean  @default(true) @map("is_active")
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([lastActiveAt])
  @@map("user_sessions")
}

// Company-scoped IP allow list. A null companyId is a platform-wide entry, so
// the company relation stays optional.
model IpWhitelist {
  id          String   @id @db.Char(24)
  ip          String
  companyId   String?  @map("company_id") @db.Char(24)
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ip])
  @@index([companyId, enabled])
  @@index([ip, enabled])
  @@map("ip_whitelists")
}

/// User-facing audit trail: one row per API action, shown in the audit trail and login history UIs.
model ActionLog {
  id          String   @id @db.Char(24)
  companyId   String?  @map("company_id") @db.Char(24)
  userId      String?  @map("user_id") @db.Char(24)
  action      String
  module      String
  targetId    String?  @map("target_id")
  targetModel String?  @map("target_model")
  details     Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, module, createdAt])
  @@index([companyId, action, createdAt])
  @@index([userId, createdAt])
  @@map("action_logs")
}

/// System audit trail with before/after diffs, retained for regulatory reporting.
model AuditLog {
  id           String   @id @db.Char(24)
  companyId    String?  @map("company_id") @db.Char(24)
  userId       String?  @map("user_id") @db.Char(24)
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  changes      Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  status       String   @default("success")
  errorMessage String?  @map("error_message")
  durationMs   Int?     @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, action])
  @@map("audit_logs")
}

enum TillSessionStatus {
  open
  closed
}

/// Cashier till sessions: the POS/direct-sale flow refuses to record a sale
/// unless the cashier has an open till.
model TillSession {
  id           String            @id @db.Char(24)
  companyId    String            @map("company_id") @db.Char(24)
  openedById   String            @map("opened_by") @db.Char(24)
  status       TillSessionStatus @default(open)
  openingFloat Decimal           @default(0) @map("opening_float") @db.Decimal(19, 2)
  closingCount Decimal?          @map("closing_count") @db.Decimal(19, 2)
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedBy User    @relation(fields: [openedById], references: [id])

  @@index([companyId, openedById, status])
  @@index([companyId, status, openedAt(sort: Desc)])
  @@map("till_sessions")
}

/// Customer prepayments recognised as revenue over time. `recognitions` holds the
/// schedule rows ({ _id, amount, date, description, status, journalEntryId }).
model DeferredRevenue {
  id                 String   @id @db.Char(24)
  companyId          String   @map("company_id") @db.Char(24)
  referenceNo        String   @map("reference_no")
  customer           String   @default("")
  description        String
  totalAmount        Decimal  @map("total_amount") @db.Decimal(19, 2)
  revenueAccountCode String   @map("revenue_account_code")
  paymentMethod      String   @default("cash") @map("payment_method")
  bankAccountId      String?  @map("bank_account_id") @db.Char(24)
  startDate          DateTime @map("start_date") @db.Timestamptz(3)
  endDate            DateTime @map("end_date") @db.Timestamptz(3)
  frequency          String   @default("monthly")
  status             String   @default("active")
  remainingBalance   Decimal  @default(0) @map("remaining_balance") @db.Decimal(19, 2)
  totalRecognized    Decimal  @default(0) @map("total_recognized") @db.Decimal(19, 2)
  recognitions       Json     @default("[]")
  journalEntryId     String?  @map("journal_entry_id") @db.Char(24)
  notes              String?
  createdById        String?  @map("created_by") @db.Char(24)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, referenceNo])
  @@index([companyId, status])
  @@map("deferred_revenues")
}

/// Prepaid costs amortised over time — the expense-side mirror of DeferredRevenue.
/// `amortizations` holds the schedule rows in the same shape.
model PrepaidExpense {
  id                 String   @id @db.Char(24)
  companyId          String   @map("company_id") @db.Char(24)
  referenceNo        String   @map("reference_no")
  vendor             String   @default("")
  description        String
  totalAmount        Decimal  @map("total_amount") @db.Decimal(19, 2)
  expenseAccountCode String   @map("expense_account_code")
  paymentMethod      String   @default("cash") @map("payment_method")
  bankAccountId      String?  @map("bank_account_id") @db.Char(24)
  startDate          DateTime @map("start_date") @db.Timestamptz(3)
  endDate            DateTime @map("end_date") @db.Timestamptz(3)
  frequency          String   @default("monthly")
  status             String   @default("active")
  remainingBalance   Decimal  @default(0) @map("remaining_balance") @db.Decimal(19, 2)
  totalAmortized     Decimal  @default(0) @map("total_amortized") @db.Decimal(19, 2)
  amortizations      Json     @default("[]")
  journalEntryId     String?  @map("journal_entry_id") @db.Char(24)
  notes              String?
  createdById        String?  @map("created_by") @db.Char(24)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, referenceNo])
  @@index([companyId, status])
  @@map("prepaid_expenses")
}

// Phase 2 — Master data enums
enum ClientType {
  individual
  company
}

enum PaymentTerms {
  cash
  credit_7
  credit_15
  credit_30
  credit_45
  credit_60
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
  cogs
}

enum NormalBalance {
  debit
  credit
}

enum TaxRateType {
  vat
  sales_tax
  withholding
  exempt
  zero_rated
}

enum TaxRecordType {
  vat
  corporate_income
  paye
  withholding
  trading_license
}

enum TaxRecordStatus {
  active
  inactive
  pending
}

enum TradingLicenseStatus {
  active
  expired
  pending
  not_applicable
}

enum BarcodeType {
  CODE128
  EAN13
  EAN8
  UPC
  CODE39
  ITF14
  QR
  NONE
}

enum CostingMethod {
  fifo
  weighted
  wac
  avg
}

enum TrackingType {
  none
  batch
  serial
}

enum EbmRegistrationStatus {
  not_registered
  registered
  failed
}

enum ExchangeRateSource {
  manual
  api
  import
}

// --- Phase 2 models ---

model Category {
  id                      String   @id @db.Char(24)
  companyId               String   @map("company_id") @db.Char(24)
  name                    String
  description             String?
  parentId                String?  @map("parent_id") @db.Char(24)
  defaultInventoryAccount String?  @map("default_inventory_account")
  defaultCogsAccount      String?  @map("default_cogs_account")
  defaultRevenueAccount   String?  @map("default_revenue_account")
  isActive                Boolean  @default(true) @map("is_active")
  createdById             String?  @map("created_by") @db.Char(24)
  customFields            Json     @default("{}") @map("custom_fields")
