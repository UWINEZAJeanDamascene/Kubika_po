  periodStart          DateTime? @map("period_start") @db.Timestamptz(3)
  periodEnd            DateTime? @map("period_end") @db.Timestamptz(3)
  periodType           String    @default("yearly") @map("period_type")
  amount               Decimal   @default(0) @db.Decimal(19, 2)
  departmentId         String?   @map("department_id") @db.Char(24)
