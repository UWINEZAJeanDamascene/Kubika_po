model BankAccount {
  id                      String    @id @db.Char(24)
  companyId               String    @map("company_id") @db.Char(24)
  name                    String
  accountNumber           String?   @map("account_number")
  bankName                String?   @map("bank_name")
  currencyCode            String    @default("USD") @map("currency_code")
  ledgerAccountId         String    @default("1100") @map("ledger_account_id")
  openingBalance          Decimal   @default(0) @map("opening_balance") @db.Decimal(19, 2)
  openingBalanceDate      DateTime  @default(now()) @map("opening_balance_date") @db.Timestamptz(3)
  isActive                Boolean   @default(true) @map("is_active")
  isDefault               Boolean   @default(false) @map("is_default")
  accountType             String    @default("bk_bank") @map("account_type")
  branch                  String?
  swiftCode               String?   @map("swift_code")
  cachedBalance           Decimal   @default(0) @map("cached_balance") @db.Decimal(19, 2)
  cacheValid              Boolean   @default(false) @map("cache_valid")
  cacheLastComputed       DateTime? @map("cache_last_computed") @db.Timestamptz(3)
  targetBalance           Decimal   @default(0) @map("target_balance") @db.Decimal(19, 2)
  holderName              String?   @map("holder_name")
  lastReconciledAt        DateTime? @map("last_reconciled_at") @db.Timestamptz(3)
  lastReconciledBalance   Decimal   @default(0) @map("last_reconciled_balance") @db.Decimal(19, 2)
  notes                   String?
  color                   String    @default("#3B82F6")
  icon                    String    @default("bank")
  interestAccountType     String    @default("current") @map("interest_account_type")
  interestRate            Decimal   @default(0) @map("interest_rate") @db.Decimal(19, 4)
  interestCalculationMethod String  @default("simple") @map("interest_calculation_method")
  interestCreditFrequency String    @default("monthly") @map("interest_credit_frequency")
  interestIncomeAccount   String    @default("4300") @map("interest_income_account")
  interestAccrualAccount  String    @default("1350") @map("interest_accrual_account")
  bankStatementReference  Boolean   @default(false) @map("bank_statement_reference")
  interestStartDate       DateTime? @map("interest_start_date") @db.Timestamptz(3)
  lastInterestPostedDate  DateTime? @map("last_interest_posted_date") @db.Timestamptz(3)
  customFields            Json      @default("{}") @map("custom_fields")
  createdById             String?   @map("created_by") @db.Char(24)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company                  Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions             BankTransaction[]
  statementLines           BankStatementLine[]
  reconciliations          BankReconciliation[]
  reconciliationSessions   BankReconciliationSession[]
  statementTransactions    BankStatementTransaction[]
  reconciliationMatches    BankReconciliationMatch[]
  pettyCashReplenishments  PettyCashReplenishment[]

  @@index([companyId, isActive])
  @@index([companyId, accountType])
  @@index([companyId, isDefault])
  @@map("bank_accounts")
}

model BankTransaction {
  id                   String    @id @db.Char(24)
  companyId            String    @map("company_id") @db.Char(24)
  bankAccountId        String    @map("bank_account_id") @db.Char(24)
  type                 String
  amount               Decimal   @db.Decimal(19, 2)
  balanceAfter         Decimal   @map("balance_after") @db.Decimal(19, 2)
  balance              Decimal   @default(0) @db.Decimal(19, 2)
  reference            Json?
  referenceType        String?   @map("reference_type")
  description          String?
  date                 DateTime  @default(now()) @db.Timestamptz(3)
  paymentMethod        String    @default("bank_transfer") @map("payment_method")
  referenceNumber      String?   @map("reference_number")
  status               String    @default("completed")
  notes                String?
  attachments          Json      @default("[]")
  journalEntryId       String?   @map("journal_entry_id") @db.Char(24)
  journalEntryLineId   String?   @map("journal_entry_line_id") @db.Char(24)
  transactionType      String    @default("other") @map("transaction_type")
  sourceDocumentType   String    @default("journal_entry") @map("source_document_type")
  sourceDocumentId     String?   @map("source_document_id") @db.Char(24)
  sourceReference      String?   @map("source_reference")
  reconciliationStatus String    @default("unreconciled") @map("reconciliation_status")
  reconciledSessionId  String?   @map("reconciled_session_id") @db.Char(24)
  isReversed           Boolean   @default(false) @map("is_reversed")
  reversalTransactionId String?  @map("reversal_transaction_id") @db.Char(24)
  createdById          String    @map("created_by") @db.Char(24)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount                @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciledSession BankReconciliationSession? @relation(fields: [reconciledSessionId], references: [id])
  reversalTransaction BankTransaction?         @relation("BankTxReversal", fields: [reversalTransactionId], references: [id])
  reversedBy        BankTransaction[]          @relation("BankTxReversal")
  bookMatches       BankReconciliationMatch[]
  matchedStatementTransactions BankStatementTransaction[]

  @@index([companyId, bankAccountId, date(sort: Desc)])
  @@index([companyId, bankAccountId, reconciliationStatus])
  @@index([companyId, journalEntryId, journalEntryLineId])
  @@index([bankAccountId, date(sort: Desc)])
  @@map("bank_transactions")
}

model BankStatementLine {
  id                String    @id @db.Char(24)
  companyId         String    @map("company_id") @db.Char(24)
  bankAccountId     String    @map("bank_account_id") @db.Char(24)
  reconciliationId  String?   @map("reconciliation_id") @db.Char(24)
  transactionDate   DateTime  @map("transaction_date") @db.Timestamptz(3)
  description       String
  debitAmount       Decimal   @default(0) @map("debit_amount") @db.Decimal(19, 2)
  creditAmount      Decimal   @default(0) @map("credit_amount") @db.Decimal(19, 2)
  balance           Decimal?  @db.Decimal(19, 2)
  reference         String?
  status            String    @default("unmatched")
  isReconciled      Boolean   @default(false) @map("is_reconciled")
  matchedAmount     Decimal?  @map("matched_amount") @db.Decimal(19, 2)
