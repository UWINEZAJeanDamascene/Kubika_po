  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             AssetCategory?        @relation(fields: [categoryId], references: [id])
  disposalEvent        AssetDisposalEvent?   @relation("FixedAssetDisposalEvent", fields: [disposalEventId], references: [id])
  depreciationEntries  DepreciationEntry[]
  disposalEvents       AssetDisposalEvent[]  @relation("DisposedAsset")
  tradeInDisposals     AssetDisposalEvent[]  @relation("TradeInAsset")
  statusHistories      AssetStatusHistory[]

  @@unique([companyId, referenceNo])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id                  String    @id @db.Char(24)
  companyId           String    @map("company_id") @db.Char(24)
  assetId             String    @map("asset_id") @db.Char(24)
  periodDate          DateTime  @map("period_date") @db.Timestamptz(3)
  depreciationAmount  Decimal   @map("depreciation_amount") @db.Decimal(19, 2)
  accumulatedBefore   Decimal   @map("accumulated_before") @db.Decimal(19, 2)
  accumulatedAfter    Decimal   @map("accumulated_after") @db.Decimal(19, 2)
  netBookValueAfter   Decimal   @map("net_book_value_after") @db.Decimal(19, 2)
  journalEntryId      String    @map("journal_entry_id") @db.Char(24)
  postedById          String    @map("posted_by") @db.Char(24)
  isReversed          Boolean   @default(false) @map("is_reversed")
  reversedById        String?   @map("reversed_by") @db.Char(24)
  reversedAt          DateTime? @map("reversed_at") @db.Timestamptz(3)
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([companyId, assetId, periodDate])
  @@index([companyId, periodDate])
  @@map("depreciation_entries")
}

model AssetDisposalEvent {
  id                     String    @id @db.Char(24)
  companyId              String    @map("company_id") @db.Char(24)
  assetId                String    @map("asset_id") @db.Char(24)
  disposalDate           DateTime  @map("disposal_date") @db.Timestamptz(3)
  disposalMethod         String    @map("disposal_method")
  grossProceeds          Decimal   @default(0) @map("gross_proceeds") @db.Decimal(19, 2)
  disposalCosts          Decimal   @default(0) @map("disposal_costs") @db.Decimal(19, 2)
  netProceeds            Decimal   @map("net_proceeds") @db.Decimal(19, 2)
  originalCost           Decimal   @map("original_cost") @db.Decimal(19, 2)
  accumulatedDepreciation Decimal  @map("accumulated_depreciation") @db.Decimal(19, 2)
  netBookValue           Decimal   @map("net_book_value") @db.Decimal(19, 2)
  gainLoss               Decimal   @map("gain_loss") @db.Decimal(19, 2)
  gainLossType           String    @map("gain_loss_type")
  disposalJournalEntryId String?   @map("disposal_journal_entry_id") @db.Char(24)
  tradeInAssetId         String?   @map("trade_in_asset_id") @db.Char(24)
  tradeInValue           Decimal?  @map("trade_in_value") @db.Decimal(19, 2)
  soldToCustomerId       String?   @map("sold_to_customer_id") @db.Char(24)
  saleInvoiceId          String?   @map("sale_invoice_id") @db.Char(24)
  proceedsBankAccountId  String?   @map("proceeds_bank_account_id") @db.Char(24)
  disposalAuthNumber     String?   @map("disposal_auth_number")
  rraNotified            Boolean   @default(false) @map("rra_notified")
  rraNotificationDate    DateTime? @map("rra_notification_date") @db.Timestamptz(3)
  attachments            Json      @default("[]")
  processedById          String    @map("processed_by") @db.Char(24)
  processedAt            DateTime  @default(now()) @map("processed_at") @db.Timestamptz(3)
  notes                  String?
  isReversed             Boolean   @default(false) @map("is_reversed")
  reversedAt             DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedById           String?   @map("reversed_by") @db.Char(24)
  reversalReason         String?   @map("reversal_reason")

  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset          FixedAsset  @relation("DisposedAsset", fields: [assetId], references: [id], onDelete: Cascade)
  tradeInAsset   FixedAsset? @relation("TradeInAsset", fields: [tradeInAssetId], references: [id])
  linkedAsset    FixedAsset? @relation("FixedAssetDisposalEvent")

  @@index([companyId, assetId])
  @@index([companyId, disposalDate(sort: Desc)])
  @@index([companyId, disposalMethod])
  @@index([companyId, gainLossType])
  @@map("asset_disposal_events")
}

model AssetStatusHistory {
  id                    String   @id @db.Char(24)
  companyId             String   @map("company_id") @db.Char(24)
  assetId               String   @map("asset_id") @db.Char(24)
  fromStatus            String   @map("from_status")
  toStatus              String   @map("to_status")
