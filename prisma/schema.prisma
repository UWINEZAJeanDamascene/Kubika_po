  defaultDate              DateTime? @map("default_date") @db.Timestamptz(3)
  writeOffAmount           Decimal   @default(0) @map("write_off_amount") @db.Decimal(19, 2)
  writeOffDate             DateTime? @map("write_off_date") @db.Timestamptz(3)
  createdById              String    @map("created_by") @db.Char(24)
