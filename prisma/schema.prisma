// ── Phase 10 — Budget ──────────────────────────────────────────────────────

model Budget {
  id                   String    @id @db.Char(24)
  companyId            String    @map("company_id") @db.Char(24)
  name                 String
  code                 String?
  description          String    @default("")
  purpose              String    @default("")
  tags                 String[]  @default([])
  category             String?
  type                 String    @default("expense")
